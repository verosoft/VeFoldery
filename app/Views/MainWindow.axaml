<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:VeFoldery.Avalonia.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="860" d:DesignHeight="560"
        x:Class="VeFoldery.Avalonia.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="VeFoldery — File &amp; Folder Organizer"
        Width="880" Height="580" MinWidth="640" MinHeight="420">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="12">

        <!-- Toolbar -->
        <StackPanel Grid.Row="0" Spacing="8" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Choose folder…" Command="{Binding BrowseCommand}" />
                <Button Content="Show in Finder" Command="{Binding RevealFolderCommand}"
                        IsEnabled="{Binding HasFolder}" />
                <Button Content="Rescan" Command="{Binding RescanCommand}"
                        IsEnabled="{Binding HasFolder}" />
                <Button Content="↺ Undo last run" Command="{Binding UndoCommand}"
                        IsEnabled="{Binding HasFolder}" />
                <Button Content="⚙ Preferences" Command="{Binding PreferencesCommand}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Mode:" VerticalAlignment="Center" />
                <ComboBox x:Name="ModeSelector" MinWidth="190" SelectedIndex="0">
                    <ComboBoxItem Content="Date timeline" Tag="Date" />
                    <ComboBoxItem Content="Category" Tag="Category" />
                    <ComboBoxItem Content="Extension" Tag="Extension" />
                    <ComboBoxItem Content="Category + Date" Tag="CategoryAndDate" />
                    <ComboBoxItem Content="Date + Category" Tag="DateAndCategory" />
                </ComboBox>
                <CheckBox Content="Include top-level folders"
                          IsChecked="{Binding IncludeFolders}" />
                <TextBlock Text="Theme:" VerticalAlignment="Center" Margin="12,0,0,0" Classes="label" />
                <ComboBox MinWidth="100" ItemsSource="{Binding ThemeOptions}"
                          SelectedItem="{Binding SelectedTheme}" />
            </StackPanel>
        </StackPanel>

        <!-- File list -->
        <Border Grid.Row="2" BorderBrush="Gray" BorderThickness="1" CornerRadius="4">
            <DataGrid ItemsSource="{Binding Files}"
                      AutoGenerateColumns="False"
                      CanUserSortColumns="True"
                      IsReadOnly="False"
                      HeadersVisibility="All"
                      GridLinesVisibility="Horizontal">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="52">
                        <DataGridTemplateColumn.HeaderTemplate>
                            <DataTemplate>
                                <Panel Width="52" Margin="-10,0,-10,0" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <ToggleButton IsChecked="{Binding $parent[Window].DataContext.AllSelected, Mode=TwoWay}"
                                              Width="18" Height="18" Margin="-10,0,-10,0" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              ToolTip.Tip="Select / deselect all">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="root" Width="16" Height="16" CornerRadius="4"
                                                    Background="#d1d5db" BorderThickness="1" BorderBrush="#b9bec8">
                                                <Path x:Name="check" Data="M 2.5,8 L 6,11.5 L 13,4"
                                                      Stroke="#ffffff" StrokeThickness="2"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      IsVisible="False"/>
                                            </Border>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                    <ToggleButton.Styles>
                                        <Style Selector="ToggleButton:checked /template/ Border#root">
                                            <Setter Property="Background" Value="#007AFF" />
                                            <Setter Property="BorderBrush" Value="#007AFF" />
                                        </Style>
                                        <Style Selector="ToggleButton:checked /template/ Path#check">
                                            <Setter Property="IsVisible" Value="True" />
                                        </Style>
                                        <Style Selector="ToggleButton:indeterminate /template/ Border#root">
                                            <Setter Property="Background" Value="#9ec3ff" />
                                        </Style>
                                        <Style Selector="ToggleButton:indeterminate /template/ Path#check">
                                            <Setter Property="IsVisible" Value="True" />
                                            <Setter Property="Opacity" Value="0.55" />
                                        </Style>
                                    </ToggleButton.Styles>
                                </ToggleButton>
                                </Panel>
                            </DataTemplate>
                        </DataGridTemplateColumn.HeaderTemplate>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="vm:FileEntryViewModel">
                                <Panel Width="52" Margin="-10,0,-10,0" HorizontalAlignment="Left">
                                    <CheckBox IsChecked="{Binding Include}" HorizontalAlignment="Center" />
                                </Panel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="3*" IsReadOnly="True" />
                    <DataGridTextColumn Header="Type" Binding="{Binding TypeDisplay}" Width="90" IsReadOnly="True" />
                    <DataGridTextColumn Header="Destination" Binding="{Binding TargetFolder}" Width="2*" IsReadOnly="True" />
                    <DataGridTextColumn Header="Size" Binding="{Binding SizeDisplay}" Width="80" IsReadOnly="True" />
                    <DataGridTextColumn Header="Modified" Binding="{Binding ModifiedDisplay}" Width="130" IsReadOnly="True" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Status bar -->
        <Grid Grid.Row="3" Margin="0,8,0,0" ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Text="{Binding StatusText}" TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center" Classes="status" />
            <Button Grid.Column="1" Content="{Binding OrganizeButtonText}"
                    Command="{Binding OrganizeCommand}"
                    IsEnabled="{Binding CanOrganize}"
                    Classes="primary"
                    Padding="24,6" FontWeight="SemiBold" />
        </Grid>

    </Grid>

</Window>